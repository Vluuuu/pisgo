# TomTom (Location Search & Geocoding - Required for standard address search)
TOMTOM_API_KEY=your_tomtom_api_key_here

# Foursquare (POI Location Search - Optional fallback)
FOURSQUARE_API_KEY=your_foursquare_api_key_here

# Geoapify (Routing & Map Tiles - Required for road routing & ETA)
GEOAPIFY_API_KEY=your_geoapify_api_key_here

# Web branding
NEXT_PUBLIC_APP_NAME=PisGO

# AI service (FastAPI maturity inference service - server-side only)
AI_API_BASE_URL=http://127.0.0.1:8001
