{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pisgo.local/schemas/prediction.schema.json",
  "title": "PisGoPredictionResponse",
  "type": "object",
  "required": [
    "banana_detected",
    "cultivar",
    "days_after_flowering",
    "current_maturity",
    "confidence",
    "model_version"
  ],
  "properties": {
    "banana_detected": {
      "type": "boolean"
    },
    "cultivar": {
      "type": "string",
      "const": "cavendish"
    },
    "days_after_flowering": {
      "type": "integer",
      "minimum": 0
    },
    "current_maturity": {
      "type": "number"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "days_to_target": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "model_version": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
