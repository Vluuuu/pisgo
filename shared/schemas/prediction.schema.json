{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pisgo.local/schemas/prediction.schema.json",
  "title": "PisGoPredictionResponse",
  "type": "object",
  "required": [
    "banana_detected",
    "cultivar",
    "days_after_flowering",
    "current_maturity",
    "confidence",
    "days_to_target",
    "model_version",
    "adapter_version",
    "debug"
  ],
  "properties": {
    "banana_detected": {
      "type": "boolean"
    },
    "cultivar": {
      "type": "string",
      "const": "cavendish"
    },
    "days_after_flowering": {
      "type": "integer",
      "minimum": 0
    },
    "current_maturity": {
      "type": ["number", "null"],
      "minimum": 1,
      "maximum": 7,
      "description": "Probability-weighted PisGo design mapping from visual class probabilities to the UI scale. Null when banana_detected is false."
    },
    "confidence": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 1,
      "description": "Uncalibrated maximum class-probability score. Null when banana_detected is false."
    },
    "days_to_target": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "model_version": {
      "type": "string"
    },
    "adapter_version": {
      "type": "string"
    },
    "debug": {
      "$ref": "#/$defs/predictionDebug"
    }
  },
  "$defs": {
    "predictionDebug": {
      "type": "object",
      "required": [
        "predicted_class",
        "class_probabilities",
        "maturity_class_scale",
        "detector_model_version",
        "detection_score",
        "detection_count",
        "detection_threshold",
        "detection_method",
        "detector_inference_milliseconds",
        "inference_milliseconds"
      ],
      "properties": {
        "predicted_class": {
          "type": ["string", "null"],
          "enum": ["unripe", "half_ripe", "ripe", "overripe", null]
        },
        "class_probabilities": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "required": ["unripe", "half_ripe", "ripe", "overripe"],
              "properties": {
                "unripe": {"type": "number", "minimum": 0, "maximum": 1},
                "half_ripe": {"type": "number", "minimum": 0, "maximum": 1},
                "ripe": {"type": "number", "minimum": 0, "maximum": 1},
                "overripe": {"type": "number", "minimum": 0, "maximum": 1}
              },
              "additionalProperties": false
            }
          ]
        },
        "maturity_class_scale": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "required": ["unripe", "half_ripe", "ripe", "overripe"],
              "properties": {
                "unripe": {"type": "number"},
                "half_ripe": {"type": "number"},
                "ripe": {"type": "number"},
                "overripe": {"type": "number"}
              },
              "additionalProperties": false
            }
          ]
        },
        "detector_model_version": {"type": "string", "minLength": 1},
        "detection_score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "detection_count": {"type": "integer", "minimum": 0},
        "detection_threshold": {"type": "number", "minimum": 0, "maximum": 1},
        "detection_method": {"type": "string", "const": "yolo11n-class-0"},
        "detector_inference_milliseconds": {"type": ["number", "null"], "minimum": 0},
        "inference_milliseconds": {"type": ["number", "null"], "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"banana_detected": {"const": false}},
        "required": ["banana_detected"]
      },
      "then": {
        "properties": {
          "current_maturity": {"type": "null"},
          "confidence": {"type": "null"},
          "days_to_target": {"type": "null"}
        }
      }
    }
  ],
  "additionalProperties": false
}
